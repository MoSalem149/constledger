# ── Dependencies (re-installed inside the image) ─────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# ── Environment / secrets ────────────────────────────────────────────
# Real env files never enter the image; they are provided at runtime.
.env
.env.*
!.env.example

# ── Logs ─────────────────────────────────────────────────────────────
logs/
*.log

# ── Local uploads / temp files ───────────────────────────────────────
tmp/
uploads/

# ── Git ──────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Docs (not needed at runtime) ─────────────────────────────────────
README.md
*.md
docs/

# ── Editor / OS metadata ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ── Tests / coverage ─────────────────────────────────────────────────
coverage/
.nyc_output/
test/
tests/
__tests__/

# ── Build artifacts / runtimes not used by Docker ────────────────────
dist/
.deno/
deno.json

# ── Docker meta ──────────────────────────────────────────────────────
Dockerfile
.dockerignore
docker-compose*.yml
