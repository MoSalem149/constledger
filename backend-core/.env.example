# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────

# Port the Express server listens on.
# If deploying on Deno Deploy with Node.js compat, Deno sets PORT automatically.
PORT=3000

# Runtime environment. Controls morgan log format and cookie secure flag.
# Values: development | production
NODE_ENV=development


# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────

# MongoDB connection string. Both backend-core and backend-ai share the same
# database (cpms) — they do NOT have separate DBs.
# Local:      mongodb://localhost:27017/cpms
# Atlas prod: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/cpms
MONGODB_URI=mongodb://localhost:27017/cpms


# ─────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────

# JWT secret used to SIGN tokens issued at login.
# ⚠️  This value MUST be identical to JWT_SECRET in backend-ai's .env —
#     backend-ai verifies tokens using the same secret.
# Generate a strong random value: openssl rand -hex 64
JWT_SECRET=change_this_to_a_long_random_secret

# How long issued JWT tokens remain valid.
# Uses the same format as the jsonwebtoken library (e.g. 8h, 1d, 7d).
JWT_EXPIRES_IN=8h


# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────

# Allowed origin for CORS. Set this to your Vercel frontend URL in production.
# Example: https://cpms.vercel.app
FRONTEND_URL=http://localhost:5173
