# ── Dependencies ──────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── TypeScript build output (never commit compiled JS) ────────────────
dist/
*.tsbuildinfo

# ── Environment / secrets ────────────────────────────────────────────
# .env.example is committed; actual env files are NOT.
.env
.env.*
!.env.example

# ── Logs ──────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Temp / downloaded files ──────────────────────────────────────────
# Contract PDFs are downloaded temporarily during analysis then discarded.
tmp/
temp/
downloads/

# ── Tesseract language data ──────────────────────────────────────────
# Downloaded by tesseract.js on first run; never bundle into the repo.
*.traineddata

# ── Editor / OS metadata ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ── Testing ──────────────────────────────────────────────────────────
coverage/
.nyc_output/
