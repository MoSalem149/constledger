{
  "name": "cpms-backend-ai",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/services/contract-analysis/assets','dist/services/contract-analysis/assets',{recursive:true})\"",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "test:watch": "vitest --pool=threads --maxWorkers=1",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1065.0",
    "@aws-sdk/s3-request-presigner": "^3.1065.0",
    "@napi-rs/canvas": "^0.1.65",
    "axios": "^1.7.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "openai": "^4.68.0",
    "pdfjs-dist": "^4.2.67",
    "tesseract.js": "^5.1.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.10",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.9"
  }
}
