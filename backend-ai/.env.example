# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────

# Port the Express server listens on.
# Cloud Run overrides this automatically with its own PORT value (8080),
# so you don't need to change it for production — the app reads process.env.PORT.
PORT=5000

# Runtime environment. Controls morgan log format and cookie secure flag.
# Values: development | production
NODE_ENV=development


# ─────────────────────────────────────────────
# AI MODEL PROVIDERS
# ─────────────────────────────────────────────

# Free-first primary provider. Supported values: gemini | openrouter | groq
AI_PRIMARY_PROVIDER=gemini
AI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_google_ai_studio_key_here

# Low-cost fallback used only after retryable primary-provider failures.
AI_FALLBACK_PROVIDER=openrouter
AI_FALLBACK_MODEL=google/gemini-2.5-flash
OPENROUTER_API_KEY=your_openrouter_key_here

# Per-request timeout. AI_MAX_RETRIES includes the first primary attempt.
AI_REQUEST_TIMEOUT_MS=90000
AI_MAX_RETRIES=2
AI_ENABLE_PAID_FALLBACK=true

# vision sends scanned PDF pages directly to Gemini (fast and recommended).
# ocr uses local Tesseract first for text-only model providers.
AI_SCAN_INPUT_MODE=vision

# Optional OpenRouter attribution headers.
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=CPMS Contract AI

# Optional Groq configuration for manual provider selection.
GROQ_API_KEY=


# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────

# MongoDB connection string. Both backend-ai and backend-core share the same
# database (cpms) — they do NOT have separate DBs.
# Local:      mongodb://localhost:27017/cpms
# Atlas prod: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/cpms
MONGODB_URI=mongodb://localhost:27017/cpms


# ─────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────

# JWT secret used to VERIFY tokens issued by backend-core.
# backend-ai never issues tokens — it only verifies them.
# ⚠️  This value MUST be identical to JWT_SECRET in backend-core's .env.
JWT_SECRET=change_this_to_match_backend_core_JWT_SECRET

# NOTE: not currently read anywhere in src/ — backend-core controls token
# lifetime when it issues the JWT. Safe to remove unless you wire it up.
JWT_EXPIRES_IN=8h

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────

# Allowed origin for CORS. Set this to your Vercel frontend URL in production.
# Example: https://cpms.vercel.app
FRONTEND_URL=http://localhost:5173


# ─────────────────────────────────────────────
# INTERNAL SERVICE AUTH
# ─────────────────────────────────────────────

# Shared secret between backend-core and backend-ai.
# backend-core attaches this in the x-internal-secret header when calling backend-ai.
#
# NOTE: there is currently no middleware in src/ that reads this header or
# this env var (no internalAuth.ts, no /api/internal route). Either implement
# that check or remove this variable — as-is it does nothing.
AI_SERVICE_SECRET=change_this_to_match_backend_core_AI_SERVICE_SECRET


# ─────────────────────────────────────────────
# AWS S3
# ─────────────────────────────────────────────

# Region where your S3 bucket lives.
AWS_REGION=us-east-1

# IAM credentials — use a dedicated IAM user with s3:GetObject and s3:PutObject
# scoped to the bucket below. Never use root credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The bucket name where contract files are stored.
# Keep separate buckets per environment (e.g. cpms-dev, cpms-prod).
S3_BUCKET=constledger-dev

# How long (seconds) a presigned UPLOAD URL stays valid after generation.
# 300 = 5 minutes — enough for a browser to finish uploading.
S3_UPLOAD_URL_TTL=300

# How long (seconds) a presigned DOWNLOAD URL stays valid.
# 900 = 15 minutes — enough to render/view a contract without re-requesting.
S3_DOWNLOAD_URL_TTL=900

# Maximum file size allowed for contract uploads, in bytes.
# 52428800 = 50 MB
S3_MAX_FILE_SIZE=52428800
