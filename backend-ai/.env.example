PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cpms

# LLM — set one of these
OPENAI_API_KEY=
# or use Anthropic
ANTHROPIC_API_KEY=

# Internal secret — must match backend-core AI_SERVICE_SECRET
INTERNAL_SECRET=internal_secret_key

# Core backend (for writing back AI results)
CORE_SERVICE_URL=http://backend-core:3000
