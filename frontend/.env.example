# ─────────────────────────────────────────────
# API
# ─────────────────────────────────────────────

# Base URL for all API calls made by the Axios instance in services/api.js.
# In development, Vite proxy routes /api/* to the correct backend (see vite.config.js).
# In production, Vercel rewrites do the same.
# Do NOT add a trailing slash.
VITE_API_URL=/api
